{
  "name": "oks-page-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "check:repo": "node scripts/checks/run-all.mjs",
    "test:pg": "echo 'PostgreSQL tests start in S2'",
    "test:docker": "echo 'Docker tests start in S5'",
    "ci": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm check:repo"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
