{
  "name": "@oks-page/db",
  "version": "0.1.0-beta.1",
  "description": "Database schema (Drizzle), migrations, SQLite and PostgreSQL adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./testing": {
      "types": "./dist/testing/harness.d.ts",
      "default": "./dist/testing/harness.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    }
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OKS-ORG/oks-page.git",
    "directory": "packages/db"
  },
  "homepage": "https://github.com/OKS-ORG/oks-page#readme",
  "bugs": {
    "url": "https://github.com/OKS-ORG/oks-page/issues"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
