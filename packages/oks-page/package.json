{
  "name": "oks-page",
  "version": "0.0.0",
  "private": true,
  "description": "The site, the admin and the API of oks-page as one installable package: a project re-exports its pages from here",
  "type": "module",
  "files": [
    "dist",
    "cache-handlers"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@oks-page/admin": "workspace:*",
    "@oks-page/auth": "workspace:*",
    "@oks-page/content-safety": "workspace:*",
    "@oks-page/core": "workspace:*",
    "@oks-page/db": "workspace:*",
    "@oks-page/media": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "oks-ui": "1.5.0",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
