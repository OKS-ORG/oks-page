{
  "name": "@oks-page/core",
  "version": "0.0.0",
  "private": true,
  "description": "Content engine: types, entries, revisions, taxonomies, menus, settings, hooks, permissions, jobs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./timezone": {
      "types": "./dist/timezone.d.ts",
      "default": "./dist/timezone.js"
    }
  },
  "dependencies": {
    "@oks-page/content-safety": "workspace:*",
    "@oks-page/db": "workspace:*",
    "@oks-page/media": "workspace:*",
    "@oks-page/renderer": "workspace:*",
    "nodemailer": "10.1.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "sharp": "0.35.5",
    "smtp-server": "3.21.1"
  }
}
