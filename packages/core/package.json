{
  "name": "@oks-page/core",
  "version": "0.1.0-beta.2",
  "description": "Content engine: types, entries, revisions, taxonomies, menus, settings, hooks, permissions, jobs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./contrast": {
      "types": "./dist/theme-contrast-rules.d.ts",
      "default": "./dist/theme-contrast-rules.js"
    },
    "./font-files": {
      "types": "./dist/font-files.d.ts",
      "default": "./dist/font-files.js"
    },
    "./timezone": {
      "types": "./dist/timezone.d.ts",
      "default": "./dist/timezone.js"
    },
    "./testing/netlify-server": {
      "types": "./dist/testing/netlify-server.d.ts",
      "default": "./dist/testing/netlify-server.js"
    },
    "./testing/github-server": {
      "types": "./dist/testing/github-server.d.ts",
      "default": "./dist/testing/github-server.js"
    },
    "./testing/sftp-server": {
      "types": "./dist/testing/sftp-server.d.ts",
      "default": "./dist/testing/sftp-server.js"
    }
  },
  "dependencies": {
    "@oks-page/content-safety": "workspace:*",
    "@oks-page/db": "workspace:*",
    "@oks-page/media": "workspace:*",
    "@oks-page/renderer": "workspace:*",
    "nodemailer": "10.1.7",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "@types/ssh2": "^1.15.6",
    "sharp": "0.35.5",
    "smtp-server": "3.21.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OKS-ORG/oks-page.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/OKS-ORG/oks-page#readme",
  "bugs": {
    "url": "https://github.com/OKS-ORG/oks-page/issues"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
