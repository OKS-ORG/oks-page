{
  "name": "@oks-page/forms-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "The first-party Forms plugin: a form block, spam checks, the messages kept in the plugin's own storage and an email to the owner",
  "type": "module",
  "author": "oks-page",
  "license": "MIT",
  "oksPage": {
    "type": "plugin",
    "id": "forms",
    "displayName": "Forms",
    "description": "Contact forms for your pages: the message is checked for spam, kept, and emailed to you.",
    "permissions": [
      "admin:pages",
      "email:send",
      "files:private",
      "routes:public"
    ],
    "hooks": [],
    "blocks": [
      "form"
    ],
    "blockInfo": {
      "form": {
        "label": "Form",
        "settings": {
          "title": {
            "type": "text",
            "label": "Title above the form"
          },
          "fields": {
            "type": "list",
            "label": "Form fields",
            "itemName": "field",
            "most": 30,
            "item": {
              "label": {
                "type": "text",
                "label": "Question"
              },
              "kind": {
                "type": "text",
                "label": "Answer type",
                "options": [
                  {
                    "value": "text",
                    "label": "Short text"
                  },
                  {
                    "value": "email",
                    "label": "Email address"
                  },
                  {
                    "value": "phone",
                    "label": "Phone number"
                  },
                  {
                    "value": "long",
                    "label": "Long text"
                  },
                  {
                    "value": "number",
                    "label": "Number"
                  },
                  {
                    "value": "date",
                    "label": "Date"
                  },
                  {
                    "value": "radio",
                    "label": "Round buttons (one answer)"
                  },
                  {
                    "value": "select",
                    "label": "Drop-down list (one answer)"
                  },
                  {
                    "value": "ticks",
                    "label": "Tick boxes (several answers)"
                  },
                  {
                    "value": "consent",
                    "label": "A box to tick to agree"
                  },
                  {
                    "value": "file",
                    "label": "File upload (pictures and PDF)"
                  }
                ]
              },
              "required": {
                "type": "boolean",
                "label": "Must be answered"
              },
              "options": {
                "type": "text",
                "label": "Choices, with a bar between: Red|Blue"
              }
            },
            "default": [
              {
                "label": "Name",
                "kind": "text",
                "required": true,
                "options": ""
              },
              {
                "label": "Email",
                "kind": "email",
                "required": true,
                "options": ""
              },
              {
                "label": "Message",
                "kind": "long",
                "required": true,
                "options": ""
              }
            ]
          },
          "button": {
            "type": "text",
            "label": "Text of the send button"
          },
          "thanks": {
            "type": "text",
            "label": "Thank-you message"
          },
          "thanks_page": {
            "type": "text",
            "label": "Or go to this page after sending, e.g. /thanks"
          },
          "send_to": {
            "type": "text",
            "label": "Send to (addresses, commas); empty: plugin setting"
          },
          "note": {
            "type": "text",
            "label": "Line under the fields"
          },
          "confirm": {
            "type": "boolean",
            "label": "Email a confirmation to the sender (field Email)"
          },
          "confirm_text": {
            "type": "text",
            "label": "Text of the confirmation email"
          }
        },
        "presets": [
          {
            "label": "Contact form",
            "settings": {
              "title": "Contact us",
              "fields": [
                {
                  "label": "Name",
                  "kind": "text",
                  "required": true,
                  "options": ""
                },
                {
                  "label": "Email",
                  "kind": "email",
                  "required": true,
                  "options": ""
                },
                {
                  "label": "Message",
                  "kind": "long",
                  "required": true,
                  "options": ""
                }
              ],
              "button": "Send message",
              "thanks": "Thank you. We will write back soon."
            }
          },
          {
            "label": "Ask for an offer",
            "settings": {
              "title": "Ask for an offer",
              "fields": [
                {
                  "label": "Name",
                  "kind": "text",
                  "required": true,
                  "options": ""
                },
                {
                  "label": "Email",
                  "kind": "email",
                  "required": true,
                  "options": ""
                },
                {
                  "label": "Phone",
                  "kind": "phone",
                  "required": false,
                  "options": ""
                },
                {
                  "label": "What do you need?",
                  "kind": "long",
                  "required": true,
                  "options": ""
                },
                {
                  "label": "When do you need it?",
                  "kind": "select",
                  "required": false,
                  "options": "As soon as possible|This month|Later|Just looking"
                }
              ],
              "button": "Ask for an offer",
              "thanks": "Thank you. We will send you an offer soon."
            }
          },
          {
            "label": "Call me back",
            "settings": {
              "title": "Call me back",
              "fields": [
                {
                  "label": "Name",
                  "kind": "text",
                  "required": true,
                  "options": ""
                },
                {
                  "label": "Phone number",
                  "kind": "phone",
                  "required": true,
                  "options": ""
                },
                {
                  "label": "Best time to call",
                  "kind": "select",
                  "required": false,
                  "options": "Morning|Afternoon|Evening"
                }
              ],
              "button": "Call me back",
              "thanks": "Thank you. We will call you back."
            }
          },
          {
            "label": "Newsletter sign-up",
            "settings": {
              "title": "Stay in touch",
              "fields": [
                {
                  "label": "Email",
                  "kind": "email",
                  "required": true,
                  "options": ""
                },
                {
                  "label": "I agree to get news by email",
                  "kind": "consent",
                  "required": true,
                  "options": ""
                }
              ],
              "button": "Sign up",
              "thanks": "Thank you for signing up.",
              "note": "We use your email only to send you news. You can ask us to stop at any time."
            }
          }
        ]
      }
    },
    "adminPages": [
      {
        "id": "messages",
        "title": "Form messages",
        "view": {
          "type": "table",
          "source": "storage:messages",
          "order": "desc",
          "columns": [
            {
              "field": "at",
              "label": "Received",
              "format": "datetime"
            },
            {
              "field": "title",
              "label": "Form",
              "truncate": 40
            },
            {
              "field": "status",
              "label": "Status"
            },
            {
              "field": "summary",
              "label": "Message",
              "truncate": 140
            },
            {
              "field": "files",
              "label": "Files",
              "format": "files"
            }
          ],
          "filters": [
            {
              "label": "New",
              "field": "status",
              "value": "new"
            },
            {
              "label": "Read",
              "field": "status",
              "value": "read"
            },
            {
              "label": "Spam",
              "field": "status",
              "value": "spam"
            }
          ],
          "actions": [
            {
              "id": "read",
              "label": "Mark as read",
              "kind": "set",
              "field": "status",
              "value": "read"
            },
            {
              "id": "new",
              "label": "Mark as new",
              "kind": "set",
              "field": "status",
              "value": "new"
            },
            {
              "id": "delete",
              "label": "Delete",
              "kind": "delete"
            }
          ],
          "empty": "No messages here.",
          "export": true
        }
      }
    ],
    "jobs": {
      "keep": {
        "everyMinutes": 1440
      }
    },
    "routes": {
      "send": {
        "method": "POST",
        "maxBytes": 30000,
        "uploads": {
          "files": 3,
          "maxFileBytes": 10485760
        }
      }
    },
    "settings": {
      "send_to": {
        "type": "text",
        "label": "Send messages to (addresses, separated by commas)"
      },
      "privacy_page": {
        "type": "text",
        "label": "Your privacy page, e.g. /privacy (linked under forms)"
      },
      "blocked_words": {
        "type": "text",
        "label": "Words that mark a message as spam, separated by commas"
      },
      "keep_months": {
        "type": "number",
        "label": "Months to keep messages (1 to 36, default 12)"
      }
    }
  }
}
