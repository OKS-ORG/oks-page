{
  "name": "@oks-page/business-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "The first-party Business plugin: business details, opening hours with an \"open now\" line, a contact details block, a payment link, and structured data for search engines",
  "type": "module",
  "author": "oks-page",
  "license": "MIT",
  "oksPage": {
    "type": "plugin",
    "id": "business",
    "displayName": "Business",
    "description": "Your business on your site: details, opening hours, contact details, a payment link and reviews, and the structured data search engines read. Write opening hours like 09:00-12:00, 13:00-17:00 (empty means closed). Special days like: 2026-12-25 closed Christmas Day; 2026-12-24 09:00-12:00 Christmas Eve.",
    "permissions": [
      "admin:pages",
      "routes:public"
    ],
    "hooks": [],
    "blocks": [
      "opening-hours",
      "contact-details",
      "payment-link",
      "reviews"
    ],
    "blockInfo": {
      "opening-hours": {
        "label": "Opening hours",
        "settings": {
          "title": {
            "type": "text",
            "label": "Title above the hours (empty: \"Opening hours\")"
          }
        }
      },
      "contact-details": {
        "label": "Contact details",
        "settings": {
          "title": {
            "type": "text",
            "label": "Title above the details (optional)"
          }
        }
      },
      "payment-link": {
        "label": "Payment link",
        "settings": {
          "label": {
            "type": "text",
            "label": "Button text",
            "default": "Pay now"
          },
          "url": {
            "type": "text",
            "label": "Address of your payment page (https://...)"
          },
          "note": {
            "type": "text",
            "label": "A line under the button (optional)"
          }
        }
      },
      "reviews": {
        "label": "Reviews",
        "settings": {
          "title": {
            "type": "text",
            "label": "Title above the reviews (empty: \"Reviews\")"
          },
          "most": {
            "type": "number",
            "label": "How many reviews to show (1 to 20, default 5)"
          },
          "show_form": {
            "type": "boolean",
            "label": "Let visitors write a review",
            "default": true
          }
        }
      }
    },
    "settings": {
      "name": {
        "type": "text",
        "label": "Business name"
      },
      "type": {
        "type": "text",
        "label": "Kind of business (Restaurant, Dentist, Hair salon, Shop...)"
      },
      "street": {
        "type": "text",
        "label": "Street and number"
      },
      "postal": {
        "type": "text",
        "label": "Postal code"
      },
      "city": {
        "type": "text",
        "label": "Town or city"
      },
      "country": {
        "type": "text",
        "label": "Country (two letters, for example DE)"
      },
      "phone": {
        "type": "text",
        "label": "Phone number"
      },
      "email": {
        "type": "text",
        "label": "Email address"
      },
      "social": {
        "type": "text",
        "label": "Your pages elsewhere (https:// addresses, separated by commas)"
      },
      "time_zone": {
        "type": "text",
        "label": "Time zone of the business (for example Europe/Berlin)"
      },
      "hours_mon": {
        "type": "text",
        "label": "Monday (09:00-12:00, 13:00-17:00; empty means closed)"
      },
      "hours_tue": {
        "type": "text",
        "label": "Tuesday"
      },
      "hours_wed": {
        "type": "text",
        "label": "Wednesday"
      },
      "hours_thu": {
        "type": "text",
        "label": "Thursday"
      },
      "hours_fri": {
        "type": "text",
        "label": "Friday"
      },
      "hours_sat": {
        "type": "text",
        "label": "Saturday"
      },
      "hours_sun": {
        "type": "text",
        "label": "Sunday"
      },
      "special_days": {
        "type": "text",
        "label": "Special days, separated by semicolons (see the description)"
      }
    },
    "routes": {
      "review": {
        "method": "POST",
        "maxBytes": 8000
      }
    },
    "adminPages": [
      {
        "id": "reviews",
        "title": "Reviews",
        "view": {
          "type": "table",
          "source": "storage:reviews",
          "order": "desc",
          "columns": [
            {
              "field": "at",
              "label": "Received",
              "format": "datetime"
            },
            {
              "field": "stars",
              "label": "Stars"
            },
            {
              "field": "name",
              "label": "Name",
              "truncate": 40
            },
            {
              "field": "text",
              "label": "Review",
              "truncate": 140
            },
            {
              "field": "status",
              "label": "Status"
            }
          ],
          "filters": [
            {
              "label": "Waiting",
              "field": "status",
              "value": "pending"
            },
            {
              "label": "Approved",
              "field": "status",
              "value": "approved"
            },
            {
              "label": "Rejected",
              "field": "status",
              "value": "rejected"
            },
            {
              "label": "Spam",
              "field": "status",
              "value": "spam"
            }
          ],
          "actions": [
            {
              "id": "approve",
              "label": "Approve",
              "kind": "set",
              "field": "status",
              "value": "approved"
            },
            {
              "id": "reject",
              "label": "Reject",
              "kind": "set",
              "field": "status",
              "value": "rejected"
            },
            {
              "id": "delete",
              "label": "Delete",
              "kind": "delete"
            }
          ],
          "empty": "No reviews here.",
          "export": true
        }
      }
    ],
    "personalData": [
      {
        "id": "business-reviews",
        "label": "Reviews",
        "source": "storage:reviews",
        "match": [
          "emails"
        ],
        "show": [
          {
            "field": "at",
            "label": "Received",
            "format": "datetime"
          },
          {
            "field": "name",
            "label": "Name"
          },
          {
            "field": "text",
            "label": "Review"
          }
        ]
      }
    ]
  }
}
